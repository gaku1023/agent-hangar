{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "remote-shell",
  "description": "サーバの UI（127.0.0.1:4177）から、切断の帯の「ログを開く」と「再起動」を殻に頼むためだけの権限。起動のやり直しは与えない。",
  "windows": ["main"],
  "remote": { "urls": ["http://127.0.0.1:4177/*"] },
  "permissions": ["allow-open-log", "allow-restart-app"]
}
