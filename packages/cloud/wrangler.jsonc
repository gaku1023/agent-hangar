{
  // ローカル開発とテスト専用の設定である。
  // 実物のデプロイでは hangar setup cloud が ~/.agent-hangar/cloud/wrangler.jsonc に別の設定を書く。
  // 実物のアカウント ID とデータベース ID と Worker の URL をここに書かない。
  // JOIN_SECRET_HASH は wrangler secret で入れるので、このファイルには書かない。
  "name": "hangar-local",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [{ "binding": "DB", "database_name": "hangar-local", "database_id": "00000000-0000-0000-0000-000000000000" }],
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "hangar-local-files" }],
  // スマホの画面（packages/mobile の build の出力）。dist/app が /app/ に出る。Worker のコードより先に返る。
  // 先に npm run build -w @agent-hangar/mobile が要る。
  "assets": { "directory": "../mobile/dist" },
  // 呼び鈴（Durable Object の HangarBell）。PC が WebSocket でつなぎ、スマホの起動と問い合わせを渡す。
  // 無料プランで使えるのは SQLite 型だけなので、new_sqlite_classes で足す。
  "durable_objects": { "bindings": [{ "name": "BELL", "class_name": "HangarBell" }] },
  "migrations": [{ "tag": "bell-v1", "new_sqlite_classes": ["HangarBell"] }],
  "vars": {}
}
